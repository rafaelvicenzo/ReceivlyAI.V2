# Banco de dados — SQLite local por padrão. Troque pela URL do Postgres (ex: Supabase) quando for pra produção.
DATABASE_URL=sqlite:///./receivly.db

# Chave da API da Anthropic (Claude) — usada pelo gerador de anúncios e, futuramente, pela IA do WhatsApp.
# Gere a sua em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Chave da API da OpenAI — usada pelo Analisador Jurídico (lê PDF) e pela IA do WhatsApp (conversa em texto).
# Gere a sua em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-coloque-sua-chave-aqui
# Confira em platform.openai.com qual é o modelo mais barato com suporte a leitura de PDF/imagem disponível hoje.
OPENAI_MODEL=gpt-4o-mini
# Modelo usado pela IA do WhatsApp — pode ser o mesmo de cima, ou outro mais barato/rápido.
OPENAI_MODEL_WHATSAPP=gpt-4o-mini

# WhatsApp Cloud API (Meta for Developers > seu app > produto WhatsApp)
WHATSAPP_ACCESS_TOKEN=coloque-o-token-temporario-ou-permanente-aqui
WHATSAPP_PHONE_NUMBER_ID=coloque-o-phone-number-id-aqui
# Essa senha você inventa — é a mesma que você vai colar no painel da Meta ao configurar o webhook.
WHATSAPP_VERIFY_TOKEN=receivly-verify-123

# Usado para assinar os tokens JWT de autenticação. Troque por uma string aleatória e longa em produção.
JWT_SECRET_KEY=troque-isso-por-uma-string-secreta-bem-grande
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
