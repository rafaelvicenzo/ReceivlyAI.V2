# Banco de dados
DATABASE_URL=sqlite:///./receivly.db

# Groq — anúncios
GROQ_API_KEY=gsk_coloque-sua-chave-aqui
GROQ_MODEL=llama-3.1-8b-instant

# Gemini — WhatsApp, comparáveis, fatores, fotos
# Chave em https://aistudio.google.com/apikey
# Contas novas: gemini-3.5-flash ou gemini-3.8-flash (NÃO use 2.0/2.5 — dão 404)
# IMPORTANTE: Google Search Grounding (comparáveis com busca real) NÃO existe no plano
# gratuito para modelos 3.x. Sem billing, a app usa fallback DuckDuckGo + Gemini.
# Com billing ativo: 5.000 buscas/mês incluídas no plano pago.
GEMINI_API_KEY=coloque-sua-chave-aqui
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_PESQUISA=gemini-3.5-flash
GEMINI_MODEL_WHATSAPP=gemini-3.5-flash
GEMINI_MODEL_FOTO=gemini-3.5-flash

# Fair-use (avaliações)
FAIR_USE_MAX_MARKET_SEARCHES_PER_APPRAISAL=2
FAIR_USE_MAX_COMPARABLES_PER_SEARCH=10
FAIR_USE_MAX_APPRAISALS_PER_MONTH=25
FAIR_USE_MAX_FOTO_TOURS_PER_MONTH=10

# Comparáveis demo (sem IA) — admin usa demo por padrão; COMPARAVEIS_MODO_DEMO=true força para todos
COMPARAVEIS_DEMO_ADMIN=true
COMPARAVEIS_MODO_DEMO=false
# Fatores de homogeneização: false = só fórmulas (rápido); true = IA lê anúncio real
FATORES_USAR_IA=false

# WhatsApp Meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=receivly-verify-123

# JWT
JWT_SECRET_KEY=troque-isso-por-uma-string-secreta-bem-grande
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Asaas — cobrança PIX e liberação automática do plano
# Sandbox: https://sandbox.asaas.com | Produção: https://www.asaas.com
ASAAS_API_KEY=
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_TOKEN=troque-por-token-secreto-do-webhook
PLANO_VALOR_REAIS=249
PLANO_DIAS=30
CREDITO_PACOTE_QTD=5
CREDITO_PACOTE_VALOR=59

# E-mails com perfil admin (demos e testes — plano sempre ativo, sem limite mensal)
ADMIN_EMAILS=seu-email@exemplo.com
